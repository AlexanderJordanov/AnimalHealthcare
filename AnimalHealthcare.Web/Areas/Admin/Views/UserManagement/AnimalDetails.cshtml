@using AnimalHealthcare.Web.ViewModels.UserManagement
@model AdminAnimalDetailsViewModel

@{
    ViewData["Title"] = "Animal Details";
}

<h2 class="mb-4">Animal Details</h2>

<div class="col-md-9">

        <p class="text-primary fs-5"><strong>Name:</strong> @Model.Name</p>
        <p class="text-primary fs-5"><strong>Age:</strong> @Model.Age</p>
        <p class="text-primary fs-5"><strong>Species:</strong> @Model.Species</p>
        <p class="text-primary fs-5"><strong>Breed:</strong> @Model.Breed</p>
        <p class="text-primary fs-5"><strong>Gender:</strong> @Model.Gender</p>

</div>

<h3>Appointments</h3>

@if (Model.Appointments.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Date & Time</th>
                <th>Doctor</th>
                <th>Procedure</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appt in Model.Appointments)
            {
                <tr>
                    <td>@appt.AppointmentDateTime.ToString("g")</td>
                    <td>@appt.DoctorName</td>
                    <td>@appt.ProcedureName</td>
                    <td>
                        <a asp-action="AppointmentDetails" asp-route-id="@appt.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="CancelAppointment" asp-route-id="@appt.Id" class="btn btn-sm btn-danger">Cancel</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-primary fs-5">No appointments available for this animal.</p>
}

<a asp-action="Details" asp-controller="UserManagement" asp-route-id="@Model.UserProfileId" class="btn btn-secondary mt-3">Back to User</a>


