@using AnimalHealthcare.Web.ViewModels.UserManagement
@model SimpleUserProfileViewModel

<h2 class="text-danger">Confirm Deletion</h2>

<p class="text-primary fs-5"> Are you sure you want to delete the account for <strong>@Model.FullName</strong> (@Model.Email)?</p>

<form asp-action="DeleteUser" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="AllProfiles" class="btn btn-secondary">Cancel</a>
</form>