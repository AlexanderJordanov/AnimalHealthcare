@using AnimalHealthcare.Web.ViewModels.UserManagement
@model UserDetailsViewModel
@{
    ViewData["Title"] = "User Details";
}

<h2 class="mb-4">User Profile</h2>

<div class="col-md-9">
    <p class="text-primary fs-5"><strong>Email:</strong> @Model.Email></p>
    <p class="text-primary fs-5"><strong>Full Name:</strong> @Model.FullName</p>
    <p class="text-primary fs-5"><strong>Phone Number:</strong> @(Model.PhoneNumber ?? "You have not added a phone number.")</p>
    <p class="text-primary fs-5"><strong>Address:</strong> @(Model.Address ?? "You have not added an address.")</p>
</div>

<h3 class="mt-5">Registered Pets</h3>

@if (Model.Pets.Any())
{
    <table class="table table-bordered mt-3">
        <thead>
            <tr>
                <th>Name</th>
                <th>Species</th>
                <th>Breed</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pet in Model.Pets)
            {
                <tr>
                    <td>@pet.Name</td>
                    <td>@pet.Species</td>
                    <td>@pet.Breed</td>
                    <td>
                        <a asp-area="Admin" asp-controller="UserManagement" asp-action="PetDetails" asp-route-id="@pet.Id" class="btn btn-sm btn-primary">Details</a>
                        <form asp-area="Admin" asp-controller="UserManagement" asp-action="UnregisterPet" asp-route-id="@pet.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to unregister this pet?');">Unregister</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">This user has no registered pets.</p>
}

