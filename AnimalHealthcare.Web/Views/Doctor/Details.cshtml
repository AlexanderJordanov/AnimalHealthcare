@model AnimalHealthcare.Web.ViewModels.Doctor.DoctorDetailsViewModel
@{
    ViewData["Title"] = "Doctor Details";
}

<h5>Doctor Information</h5>
<div class="card shadow-sm mb-4">
    <div class="row g-0">
        <div class="col-md-4">
            <img src="@Model.ProfileImageUrl" alt="Doctor image" class="img-fluid rounded-start" />
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h4>@Model.Name</h4>
                <p><strong>Specialization:</strong> @Model.Specialization</p>
                <p><strong>Years of Experience:</strong> @Model.YearsOfExperience</p>
                <p><strong>Phone Number:</strong> @Model.PhoneNumber</p>
                <p><strong>Procedures:</strong> @Model.ProceduresPerformed</p>
            </div>
        </div>
    </div>
</div>

<h5>Clinic Information</h5>
<div class="card shadow-sm">
    <div class="row g-0">
        <div class="col-md-4">
            <img src="@Model.ClinicImageUrl" alt="Clinic image" class="img-fluid rounded-start" />
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h4>@Model.ClinicName</h4>
                <p><strong>Address:</strong> @Model.ClinicAddress</p>
                <p><strong>Phone:</strong> @Model.ClinicPhoneNumber</p>
            </div>
        </div>
    </div>
</div>

<a asp-action="Index" class="btn btn-primary mt-4 text-white">Back to Doctors</a>
