@model AnimalHealthcare.Web.ViewModels.Doctor.DoctorListViewModel

@{
    ViewData["Title"] = "Explore Doctors";
}

<h2 class="mb-4">Explore Doctors</h2>

<!-- Sort & Filter Dropdowns -->
<form method="get" asp-action="Index" class="mb-4 row g-3 align-items-end">
    <div class="col-auto">
        <label for="sortBy" class="form-label text-primary fw-semibold">Sort by:</label>
        <select name="sortBy" id="sortBy" class="form-select" onchange="this.form.submit()">
            <option value="">Default</option>
            <option value="speciality" selected="@(Model.CurrentSort == "speciality")">Speciality</option>
            <option value="clinic" selected="@(Model.CurrentSort == "clinic")">Clinic</option>
        </select>
    </div>

    <div class="col-auto">
        <label for="filterBy" class="form-label text-primary fw-semibold">Filter by:</label>
        <select name="filterBy" id="filterBy" class="form-select" onchange="this.form.submit()">
            <option value="">All</option>
            @foreach (var filter in Model.AvailableFilters)
            {
                <option value="@filter.Value" selected="@(filter.Value == Model.CurrentFilter ? "selected" : null)">
                    @filter.Text
                </option>
            }
        </select>
    </div>
</form>

<!-- Doctor Cards -->
@foreach (var doctor in Model.Doctors)
{
    <div class="card mb-4 shadow-sm">
        <div class="row g-0 align-items-center">
            <div class="col-md-2 p-2">
                <img src="@doctor.ProfileImageUrl" alt="Doctor image" class="img-fluid rounded-start" style="max-height: 100px; object-fit: cover;" />
            </div>
            <div class="col-md-7">
                <div class="card-body">
                    <h5 class="card-title mb-1">@doctor.Name</h5>
                    <p class="card-text mb-0"><strong>Speciality:</strong> @doctor.Specialization</p>
                    <p class="card-text mb-0"><strong>Clinic:</strong> @doctor.ClinicName</p>
                </div>
            </div>
            <div class="col-md-3 text-end pe-3">
                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Doctor" asp-action="Details" asp-route-id="@doctor.Id" class="btn btn-outline-primary btn-sm">Details</a>
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <a asp-controller="Appointment" asp-action="Create" asp-route-doctorId="@doctor.Id" class="btn btn-primary">Create Appointment</a>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-sortBy="@Model.CurrentSort">@i</a>
                </li>
            }
        </ul>
    </nav>
}
