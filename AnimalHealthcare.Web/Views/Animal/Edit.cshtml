@model AnimalHealthcare.Web.ViewModels.Animal.EditPetViewModel

@{
    ViewData["Title"] = "Edit Pet Information";
}

<h2 class="text-primary mb-4">Edit Pet Information</h2>
@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["InfoMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="Name" class="form-label fw-bold text-primary fs-5"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Age" class="form-label fw-bold text-primary fs-5"></label>
        <input asp-for="Age" class="form-control" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Species" class="form-label fw-bold text-primary fs-5"></label>
        <input asp-for="Species" class="form-control" />
        <span asp-validation-for="Species" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Breed" class="form-label fw-bold text-primary fs-5"></label>
        <input asp-for="Breed" class="form-control" />
        <span asp-validation-for="Breed" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Gender" class="form-label fw-bold text-primary fs-5"></label>
        <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<AnimalHealthcare.GCommon.Enums.AnimalGender>()">
            <option value="">Select Gender</option>
        </select>
        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>

    <input type="hidden" asp-for="Id" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}