@model AnimalHealthcare.Web.ViewModels.Appointment.CreateAppointmentViewModel
@{
    ViewData["Title"] = "Create Appointment";
}

<h2>Create Appointment</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="AnimalId" class="form-label fw-bold text-primary"></label>
        <select asp-for="AnimalId" class="form-select" asp-items="Model.UserPets">
            <option disabled selected>-- Select Pet --</option>
        </select>
        <span asp-validation-for="AnimalId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProcedureId" class="form-label fw-bold text-primary"></label>
        @if (Model.Procedures.Count() == 1)
        {
            <input type="text" class="form-control" value="@Model.Procedures.First().Text" disabled />
            <input type="hidden" name="ProcedureId" value="@Model.Procedures.First().Value" />
        }
        else
        {
            <select asp-for="ProcedureId" class="form-select" asp-items="Model.Procedures" id="procedureDropdown">
                <option disabled selected>-- Select Procedure --</option>
            </select>
        }
    </div>

    <div class="mb-3">
        <label asp-for="DoctorId" class="form-label"></label>
        @if (Model.Doctors.Count() == 1)
        {
            <input type="text" class="form-control" value="@Model.Doctors.First().Text" disabled />
            <input type="hidden" name="DoctorId" value="@Model.Doctors.First().Value" />
        }
        else
        {
            <select asp-for="DoctorId" asp-items="Model.Doctors" class="form-select" id="doctorDropdown"></select>
        }
        <span asp-validation-for="DoctorId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Date" class="form-label fw-bold text-primary"></label>
        <input asp-for="Date" class="form-control" type="date"
               min="@Model.MinDate.ToString("yyyy-MM-dd")"
               max="@Model.MaxDate.ToString("yyyy-MM-dd")"
               id="datePicker" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TimeSlot" class="form-label fw-bold text-primary"></label>
        <select asp-for="TimeSlot" class="form-select" id="timeSlotDropdown">
            <option disabled selected>-- Select Time --</option>
        </select>
        <span asp-validation-for="TimeSlot" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Book Appointment</button>
    <a asp-action="MyAppointments" class="btn btn-secondary ms-2">Back to My Appointments</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function getProcedureId() {
            const dropdown = document.getElementById("procedureDropdown");
            if (!dropdown) return $('[name="ProcedureId"]').val();
            return $(dropdown).val();
        }

        function getDoctorId() {
            const dropdown = document.getElementById("doctorDropdown");
            if (!dropdown) return $('[name="DoctorId"]').val();
            return $(dropdown).val();
        }

        function loadDoctors() {
            const procedureId = getProcedureId();
            if (!procedureId) return;

            $.getJSON(`/Appointment/GetDoctorsByProcedure?procedureId=${procedureId}`, function (data) {
                const dropdown = $('#doctorDropdown');
                dropdown.empty().append(`<option disabled selected>-- Select Doctor --</option>`);
                $.each(data, function (i, doctor) {
                    dropdown.append(`<option value="${doctor.value}">${doctor.text}</option>`);
                });
            });
        }

        function loadTimeSlots() {
            const doctorId = getDoctorId();
            const date = $('#datePicker').val();
            if (!doctorId || !date) return;

            $.getJSON(`/Appointment/GetAvailableTimeSlots?doctorId=${doctorId}&date=${date}`, function (data) {
                const dropdown = $('#timeSlotDropdown');
                dropdown.empty().append(`<option disabled selected>-- Select Time --</option>`);
                $.each(data, function (i, time) {
                    dropdown.append(`<option value="${time.value}">${time.text}</option>`);
                });
            });
        }

        $(document).ready(function () {
            const procedureId = getProcedureId();
            const doctorId = getDoctorId();
            const date = $('#datePicker').val();

            if (procedureId && $('#procedureDropdown').length === 0) {
                loadDoctors();
            }

            if (doctorId && date) {
                loadTimeSlots();
            }

            $('#procedureDropdown').on('change', function () {
                loadDoctors();
                $('#doctorDropdown').empty().append(`<option disabled selected>-- Select Doctor --</option>`);
                $('#timeSlotDropdown').empty().append(`<option disabled selected>-- Select Time --</option>`);
            });

            $('#doctorDropdown, #datePicker').on('change', function () {
                loadTimeSlots();
            });
        });
    </script>
}
