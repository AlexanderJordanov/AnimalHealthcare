@model IEnumerable<AnimalHealthcare.Web.ViewModels.Procedure.ProcedureListItemViewModel>

@{
    ViewData["Title"] = "Explore Procedures";
}

<h2 class="mb-4">Explore Procedures</h2>

@foreach (var procedure in Model)
{
    <div class="card mb-3 shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h5 class="card-title mb-1">@procedure.Name</h5>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Procedure" asp-action="Details" asp-route-id="@procedure.Id" class="btn btn-outline-primary btn-sm">
                    Details
                </a>
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a asp-controller="Appointment" asp-action="Create" asp-route-procedureId="@procedure.Id" class="btn btn-primary btn-sm">
                        Create Appointment
                    </a>
                }
            </div>
        </div>
    </div>
}
