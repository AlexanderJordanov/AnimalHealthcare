@{
    ViewData["Title"] = "Bad Request";
    var errorMessage = ViewData["ErrorMessage"] as string;
}

<div class="text-center mt-5">
    <h1 class="display-4 text-danger">400 - Bad Request</h1>
    <p class="lead text-primary fw-semibold">@errorMessage ?? "There was a problem with your request."</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Back to Home</a>
</div>

