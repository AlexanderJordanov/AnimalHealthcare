@{
    ViewData["Title"] = "Forbidden";
    var errorMessage = ViewData["ErrorMessage"] as string;
}

<div class="text-center mt-5">
    <h1 class="display-4 text-danger">403 - Forbidden</h1>
    <p class="lead text-primary fw-semibold">@errorMessage ?? "Access denied. You do not have permission to view this page."</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Back to Home</a>
</div>
