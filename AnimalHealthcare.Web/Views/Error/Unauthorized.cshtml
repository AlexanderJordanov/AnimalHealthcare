@{
    ViewData["Title"] = "Unauthorized";
    var errorMessage = ViewData["ErrorMessage"] as string;
}

<div class="text-center mt-5">
    <h1 class="display-4 text-warning">401 - Unauthorized</h1>
    <p class="lead text-primary fw-semibold">@errorMessage ?? "You are not authorized to access this resource."</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Back to Home</a>
</div>
