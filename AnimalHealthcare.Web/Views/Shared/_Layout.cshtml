@using System.Security.Claims
@{
	var urlUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - AspNetCoreArchTemplate.Web</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/cerulean/bootstrap.min.css">
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
	<header>
		<nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3" style="background-color: rgba(255, 255, 255, 0.8);">
			<div class="container-fluid">
				<a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Animal Healthcare</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
						aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
					<ul class="navbar-nav me-auto">
						<li class="nav-item">
							<a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" asp-area="" asp-controller="Doctor" asp-action="Index">Doctors</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" asp-area="" asp-controller="AnimalClinic" asp-action="Index">Clinics</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" asp-area="" asp-controller="Procedure" asp-action="Index">Procedures</a>
						</li>
					</ul>

					<ul class="navbar-nav">
						@if (User.Identity?.IsAuthenticated ?? false)
						{
							@if (User.IsInRole("Admin"))
							{
								<li class="nav-item">
									<a class="nav-link" asp-area="Admin" asp-controller="UserManagement" asp-action="AllProfiles">View All Profiles</a>
								</li>
							}
							else
							{
								<li class="nav-item">
									<a class="nav-link" asp-area="" asp-controller="Appointment" asp-action="MyAppointments">My Appointments</a>
								</li>
								<li class="nav-item">
									<a class="nav-link"
									   asp-area=""
									   asp-controller="UserProfile"
									   asp-action="ViewProfile"
									   asp-route-profileId="@urlUserId">
										View Profile
									</a>
								</li>
							}
						}

						<li class="nav-item">
							<partial name="_LoginPartial" />
						</li>
					</ul>
				</div>
			</div>
		</nav>
	</header>

	<div class="container flex-grow-1 d-flex flex-column">
		<main role="main" class="pb-3 flex-grow-1">
			@RenderBody()
		</main>
	</div>

	<footer class="border-top footer text-muted">
		<div class="container-fluid">
			&copy; 2025 - Animal Healthcare - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
		</div>
	</footer>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
