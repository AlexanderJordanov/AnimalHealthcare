@model AnimalHealthcare.Web.ViewModels.AnimalClinic.AnimalClinicDetailsViewModel

@{
    ViewData["Title"] = "Clinic Details";
}

<h2 class="mb-4">Clinic Details</h2>

<div class="card mb-4 shadow-sm">
    <div class="row g-0 align-items-center">
        <div class="col-md-3 p-3">
            <img src="@Model.ImageUrl" alt="Clinic image" class="img-fluid rounded-start" />
        </div>
        <div class="col-md-9">
            <div class="card-body">
                <h4 class="card-title">@Model.Name</h4>
                <p class="card-text"><strong>Address:</strong> @Model.Address</p>
                <p class="card-text"><strong>Phone:</strong> @Model.PhoneNumber</p>
            </div>
        </div>
    </div>
</div>

<h4 class="mt-4">Doctors at this Clinic</h4>

@if (Model.Doctors.Any())
{
    @foreach (var doctor in Model.Doctors)
    {
        <div class="card mb-3">
            <div class="row g-0 align-items-center">
                <div class="col-md-2 p-2">
                    <img src="@doctor.ProfileImageUrl" alt="Doctor image" class="img-fluid rounded-start" style="max-height: 100px; object-fit: cover;" />
                </div>
                <div class="col-md-7">
                    <div class="card-body">
                        <h5 class="card-title mb-1">@doctor.Name</h5>
                        <p class="card-text mb-0"><strong>Specialization:</strong> @doctor.Specialization</p>
                        <p class="card-text mb-0"><strong>Experience:</strong> @doctor.YearsOfExperience</p>
                        <p class="card-text mb-0"><strong>Phone:</strong> @doctor.PhoneNumber</p>
                    </div>
                </div>
                <div class="col-md-3 text-end pe-3">
                    <a asp-controller="Doctor" asp-action="Details" asp-route-id="@doctor.Id" class="btn btn-outline-primary btn-sm">View Doctor</a>
                </div>
            </div>
        </div>
    }
}
else
{
    <p>No doctors found for this clinic.</p>
}

<a asp-action="Index" class="btn btn-primary mt-3">Back to Clinics</a>

